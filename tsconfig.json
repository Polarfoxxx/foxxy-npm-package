{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "es6",
    "lib": ["dom", "dom.iterable", "esnext"],
    "sourceMap": true,
    "jsx": "react",
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "strict": true,
    "types": ["node"],
    "baseUrl": "./src",
    "paths": {
      "@assets/*": ["./src/assets/*"],
    }
  },
  "include": ["src/", "src/**/*.module.css", "images.d.ts"],
  "exclude": ["node_modules", "dist", "src/stories"]
}
